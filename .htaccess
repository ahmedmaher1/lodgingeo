# Lodgingeo — LiteSpeed/Apache rules. PHP sets headers for pages; rules here cover static files.
Options -Indexes -MultiViews
DirectoryIndex index.php
ServerSignature Off
AddDefaultCharset utf-8

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# 1. Canonical host and HTTPS (301): www -> apex, http -> https.
RewriteCond %{HTTP_HOST} ^www\.lodgingeo\.com$ [NC]
RewriteRule ^ https://lodgingeo.com%{REQUEST_URI} [R=301,L,NE]
RewriteCond %{HTTP_HOST} ^lodgingeo\.com$ [NC]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://lodgingeo.com%{REQUEST_URI} [R=301,L,NE]

# 2. /index.php -> / (only for the original request, not the internal rewrite).
RewriteCond %{THE_REQUEST} \s/+index\.php[\s?/]
RewriteRule ^index\.php$ / [R=301,L]

# 3. Deny: dotfiles and dot-directories (.git, .github, .hostinger, uploaded config), except .well-known.
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteRule (^|/)\. - [F,L]

# 4. Deny: private directories (real files only; /data/ page URLs are routed to PHP).
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^(inc|data|storage|vendor|tools|tests|docs)/ - [F,L]
RewriteRule ^(inc|storage|vendor|tools|tests|docs)(/.*)?$ - [F,L]

# 5. Deny: source and data file types outside assets/, PHP other than index.php, composer files.
RewriteCond %{REQUEST_URI} !^/assets/
RewriteRule \.(md|py|csv|json|lock|yml|yaml|sh|sqlite|log|ini|dist|bak|xlsx)$ - [F,L]
RewriteCond %{REQUEST_URI} !^/index\.php$
RewriteRule \.php$ - [F,L]
RewriteRule (^|/)composer\. - [F,L]

# 6. Front controller: everything that is not a real file goes to index.php.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [L,QSA]
</IfModule>

# Headers for static files (pages get theirs from PHP).
<IfModule mod_headers.c>
  Header always unset X-Powered-By
  <FilesMatch "\.(css|js|svg|png|ico|txt|xml)$">
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
  </FilesMatch>
  <FilesMatch "\.(png|svg|ico)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  <FilesMatch "^(robots|llms)\.txt$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType image/svg+xml .svg
  AddType text/plain .txt
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json application/xml text/xml image/svg+xml text/plain
</IfModule>
